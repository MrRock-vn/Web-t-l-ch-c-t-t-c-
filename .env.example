# Cấu hình mẫu môi trường — sao chép thành .env và thay bằng giá trị thật trước khi chạy
PORT=4000
NODE_ENV=development

# Chuỗi kết nối MongoDB (local hoặc MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/barber_spa

# Chỉ bật true khi phát triển/demo trên máy chưa cài MongoDB (dữ liệu sẽ mất khi tắt server)
MEMORY_DB_FALLBACK=false

# Khóa bí mật ký JWT (bắt buộc, nên tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=thay_bang_chuoi_bi_mat_ngau_nhien_toi_thieu_32_ky_tu
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Cấu hình cổng thanh toán VNPay
VNP_TMN_CODE=YOUR_VNP_TMN_CODE
VNP_HASH_SECRET=YOUR_VNP_HASH_SECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:4000/api/payments/vnpay/return

# Chỉ bật true ở môi trường dev/demo nếu muốn trả URL mô phỏng callback VNPay
VNP_SIMULATE=false

# Danh sách Origin được phép gọi API (phân cách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000,http://127.0.0.1:5173

# Khóa mã hóa AES-256-GCM cho dữ liệu nhạy cảm lưu trữ
DATA_ENCRYPTION_KEY=thay_bang_khoa_ma_hoa_aes256_ngau_nhien
